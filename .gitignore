# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Downloaded datasets (regenerated by running the scripts)
data/raw/
data/processed/

# Saved model weights (regenerated by running the scripts)
# Note: keep models/<project>/v*/ structure but ignore contents.
models/*/v*/
models/*.npz
models/*.pth
models/*.joblib

# Training plots / figures (regenerated on every run)
plots/*.png
plots/*.jpg
plots/*.pdf

# Training logs (regenerated on every run)
*.log

# MLflow tracking
mlruns/
mlflow.db

# Hydra working-directory outputs (created on every run)
outputs/

# Test / coverage artefacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/

# Reports (keep folder with .gitkeep, ignore generated files)
reports/*
!reports/.gitkeep

# Docker
.docker/

# Environment
.env
.env.local